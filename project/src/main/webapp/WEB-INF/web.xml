<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="false">

    <display-name>TA Recruitment System</display-name>

    <!-- 可选：大模型 API（密钥建议用环境变量 OPENAI_API_KEY，勿在此写入真实密钥） -->
    <context-param>
        <param-name>ai.openai.baseUrl</param-name>
        <param-value>https://api.openai.com/v1</param-value>
    </context-param>
    <context-param>
        <param-name>ai.openai.model</param-name>
        <param-value>gpt-4o-mini</param-value>
    </context-param>

    <!-- Character Encoding Filter -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.bupt.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.bupt.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/ta/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/mo/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>com.bupt.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>registerServlet</servlet-name>
        <servlet-class>com.bupt.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>registerServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>com.bupt.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>jobServlet</servlet-name>
        <servlet-class>com.bupt.controller.JobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>jobServlet</servlet-name>
        <url-pattern>/jobs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>applicationServlet</servlet-name>
        <servlet-class>com.bupt.controller.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>applicationServlet</servlet-name>
        <url-pattern>/applications</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>profileServlet</servlet-name>
        <servlet-class>com.bupt.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>profileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>aiMatchServlet</servlet-name>
        <servlet-class>com.bupt.controller.AiMatchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>aiMatchServlet</servlet-name>
        <url-pattern>/api/ai/match</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
